        given-names: QingWei
    year: 2025
    doi: 10.17632/bjy7vr4xkt.1
    license: CC-BY-4.0
  - type: article
    title: "An Evaluation Method of Taekwondo Poomsae Performance"
    year: 2023
    notes: "Hoang & Ahn, JICCE 21(12)"
